    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:make-superadmin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/make-superadmin.ts",
    "db:seed-bulletin-templates": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-bulletin-templates.ts",
