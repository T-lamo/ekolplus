generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  // Set on every successful change-password/set-password — "Dernière
  // modification" on the Profil tab's password card. Not touched by any
  // other write, so it stays honest even though `updatedAt` changes on any
  // User update.
  passwordChangedAt DateTime?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // Optional contact phone — self-service via /api/auth/me PATCH.
  phone             String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // Stamped on every successful password login (login route step 8). NOT
  // stamped by the Google OAuth callback (protected file) — OAuth-only
  // users show "—" in the admin Users table until that gap is closed.
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes   VerificationCode[]
  uploads             FileUpload[]
  notifications       Notification[]
  notifPrefs          NotificationPreferences?
  orders              Order[]
  withdrawals         Withdrawal[]
  oauthAccounts       OAuthAccount[]
  adminActions        AdminAction[]
  appreciations       Appreciation[]
  attendanceMarks     Attendance[]
  recordedFeePayments FeePayment[]
  openedFeeDisputes   FeeDispute[]
  loginEvents         LoginEvent[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // EkolPlus: the school's domain-specific profile. Kept on a separate 1:1
  // model rather than fields on Organization itself, so the generic
  // multi-tenancy primitive stays untouched (see .planning/banani/OVERVIEW.md
  // architecture v2 decision log).
  school School?

  @@index([ownerId])
}

// ───────────────────────────────────────────────────────────────────────
// EkolPlus domain — school profile, 1:1 with Organization (the tenant).
// See .planning/banani/create-school.md for the screen this backs.
// ───────────────────────────────────────────────────────────────────────
model School {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  shortName            String?
  country              String
  city                 String
  schoolType           String // free-form for now (e.g. "École primaire & secondaire") — no fixed catalog yet
  primaryLanguage      String?
  address              String?
  phone                String?
  estimatedStudents    Int?
  // Added for the Établissement settings tab (school-settings.md).
  officialCode         String?
  officialEmail        String?
  website              String?
  // Statut (public/privé laïque/privé confessionnel…) — distinct from
  // schoolType, which actually models teaching *levels* (see school-settings-v2.md).
  statute              String?
  // Added for bulletin PDF generation (bulletin-pdf-and-editor-design.md).
  logoUrl              String?
  directorSignatureUrl String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  academicYears         AcademicYear[]
  subjects              Subject[]
  teachers              Teacher[]
  classes               Class[]
  students              Student[]
  bulletinTemplates     BulletinTemplate[]
  feeStructures         FeeStructure[]
  feePayments           FeePayment[]
  feeAutomationSettings FeeAutomationSettings?
  subscription          Subscription?
  billingTransactions   BillingTransaction[]
  restrictedCoupons     Coupon[]
  rolloverDraft         AcademicYearRolloverDraft?
  gradeLevels           GradeLevel[]
  timetableSessions     TimetableSession[]
  rooms                 Room[]

  @@index([organizationId])
}

// ───────────────────────────────────────────────────────────────────────
// Année scolaire — first-class per the v2 architecture decision (see
// OVERVIEW.md): everything year-scoped (classes, evaluations, grades,
// attendance, bulletins — added in later epics) hangs off this rather than
// a free-text "year" field, so promotion/rollover doesn't corrupt history.
// One school can have many AcademicYears over time; `isActive` marks the
// current one (app-level invariant: at most one active per school —
// enforced in the route, not the schema, since Prisma has no partial
// unique index in this version).
// ───────────────────────────────────────────────────────────────────────
model AcademicYear {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label        String // e.g. "2024-2025"
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  // Free text for now (e.g. "Sur 20 points") — no grading-scale catalog yet.
  gradingScale String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  terms       Term[]
  classes     Class[]
  enrollments Enrollment[]

  timetableSessions TimetableSession[]

  @@index([schoolId, isActive])
}

model AcademicYearRolloverDraft {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  newYearLabel     String
  newYearStartDate DateTime
  newYearEndDate   DateTime

  classMapping      Json @default("{}")
  studentExceptions Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  @@unique([schoolId])
}

// Per-school ordered catalog of grade levels ("6ème" → "5ème" → … →
// "Terminale"). Cross-referenced with `Class.level` by EXACT string match —
// there is deliberately no FK from Class (Class.level stays free text; see
// docs/superpowers/specs/2026-08-17-grade-level-ordering-design.md). Used by
// the rollover wizard's Step 2 to auto-suggest promotion destinations.
// `order` is only indexed, not unique: the reorder route rewrites every row's
// order for the school in one transaction, and nothing else writes it.
model GradeLevel {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, order])
}

// Trimestre/Semestre. `status` (Terminé/En cours/À venir) is NOT stored —
// computed from startDate/endDate vs. now() at read time, so it can't drift
// out of sync with the dates themselves.
model Term {
  id                String       @id @default(cuid())
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  label             String // e.g. "1er Trimestre"
  order             Int
  startDate         DateTime
  endDate           DateTime
  // TRIMESTRE | SEMESTRE | LIBRE — free text like Evaluation.type, no catalog table.
  type              String       @default("TRIMESTRE")
  // Gates POST/PUT grade-writing routes — "Saisie des notes activée" on the
  // Nouvelle période modal. Evaluation *creation* stays allowed either way
  // (configuring what will be graded is separate from entering scores).
  gradeEntryEnabled Boolean      @default(true)
  createdAt         DateTime     @default(now())

  evaluations   Evaluation[]
  goals         Goal[]
  appreciations Appreciation[]
  chapters      SubjectChapter[]

  @@index([academicYearId, order])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Epic 4 — academic configuration. Subject/Teacher/Class are school-wide
// catalogs; ClassSubject is the shared pivot backing both the Coefficients
// screen (per-class edit of `coefficient`) and the Affectations screen
// (cross-class edit of `teacherId`/`weeklyHours`/`coefficient`). See
// .planning/banani/epic-4-data-model.md for the discovery that led to one
// pivot table instead of two independent ones.
// ───────────────────────────────────────────────────────────────────────
model Subject {
  id                   String   @id @default(cuid())
  schoolId             String
  school               School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                 String
  code                 String?
  domain               String? // free text ("Sciences", "Lettres & Langues", ...) — no fixed catalog yet
  // Kept for the dashboard count + list filters; always derived from `status`
  // (`status !== 'ARCHIVED'`) by the subjects routes — never written directly.
  isActive             Boolean  @default(true)
  // ACTIVE | DRAFT | ARCHIVED — "Statut de publication" on the subject form
  // (add-matiere.md). DRAFT stays visible in the Matières list only; the
  // subjects GET excludes it by default so pickers never offer it.
  status               String   @default("ACTIVE")
  // Subject profile (add-matiere.md). Free-text catalogs live client-side
  // in subject-form.constants.ts — no lookup tables, same convention as
  // Class.level / Term.type.
  abbreviation         String?
  level                String? // "3ème / 4ème" — free text picked from the school's class levels
  kind                 String   @default("REQUIRED") // REQUIRED | ELECTIVE | OPTIONAL
  description          String?
  defaultCoefficient   Int? // pre-fills ClassSubject.coefficient when a class is attached
  maxScore             Int      @default(20)
  passingScore         Int      @default(10)
  totalHours           Int?
  hoursCM              Int?
  hoursTD              Int?
  hoursTP              Int?
  evaluationType       String?
  maxCapacity          Int?
  includeInAverage     Boolean  @default(true)
  showOnBulletin       Boolean  @default(true)
  room                 String?
  eliminatoryScore     Int?
  icon                 String? // lucide icon name from the form's fixed catalog
  color                String? // hex from the form's fixed swatch catalog
  responsibleTeacherId String?
  responsibleTeacher   Teacher? @relation("SubjectResponsible", fields: [responsibleTeacherId], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  classSubjects ClassSubject[]
  goals         Goal[]
  appreciations Appreciation[]
  chapters      SubjectChapter[]
  // Implicit self m2m: subjects that must be validated before this one.
  prerequisites Subject[]        @relation("SubjectPrerequisites")
  requiredBy    Subject[]        @relation("SubjectPrerequisites")

  timetableSessions TimetableSession[]

  @@index([schoolId])
}

// One row per chapter of a subject's annual programme, grouped by Term
// (programme-annuel.md). `order` is per (subjectId, termId); the reorder
// route rewrites the whole sequence in one transaction.
model SubjectChapter {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termId     String
  term       Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  order      Int
  title      String
  objectives String?
  hours      Float?
  reference  String? // "Manuel ch. 1-2"
  competence String? // badge shown on the chapter row
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subjectId, termId, order])
}

// Minimal stub — full profile/CRUD is Epic 5's `teachers-list` screen. V1
// only needs enough to populate ClassSubject.teacherId and Class.homeroomTeacherId.
model Teacher {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  email             String?
  phone             String?
  photoUrl          String? // Cloudinary secure_url — public, see /api/upload docs
  isActive          Boolean   @default(true)
  // Employment status shown on the Teachers List — separate from `isActive`
  // (which only gates visibility in assignment pickers, see epic-5-data-model.md).
  status            String    @default("ACTIVE") // ACTIVE | ON_LEAVE | INACTIVE
  // Profile fields from the Banani Add Teacher form (add-teacher.md).
  // `name` stays canonical (lists/bulletins/assignments consume it); the
  // form composes it from civility/firstName/lastName when they are set.
  civility          String? // "M." | "Mme" — free text
  firstName         String?
  lastName          String?
  dateOfBirth       DateTime?
  gender            String?
  nationality       String?
  idNumber          String? // ex "NIF-2024-0042"
  secondaryPhone    String?
  address           String?
  contractType      String? // Temps plein | Temps partiel | Vacataire — free text
  hiredAt           DateTime?
  // Contractual hours target — distinct from the hours computed from real
  // ClassSubject assignments shown on the Teachers list.
  weeklyHoursTarget Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  classSubjects       ClassSubject[]
  homeroomClasses     Class[]        @relation("HomeroomTeacher")
  responsibleSubjects Subject[]      @relation("SubjectResponsible")

  timetableSessions TimetableSession[]

  @@index([schoolId])
}

model Class {
  id                String       @id @default(cuid())
  schoolId          String
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name              String // "3ème A"
  level             String // "3ème" — free text, no fixed catalog yet
  // Salle : `roomId` pointe sur le catalogue (configuration/salles) ; `room`
  // garde le libellé (nom de la salle du catalogue, ou lieu libre) pour
  // l'affichage et les anciennes données.
  room              String?
  roomId            String?
  roomRef           Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  capacity          Int?
  homeroomTeacherId String?
  homeroomTeacher   Teacher?     @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  // Fiche classe (add-class.md) — couleur d'identification (#rrggbb, palette
  // partagée avec les matières) et filière / série (texte libre, optionnel).
  color             String?
  track             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  classSubjects ClassSubject[]
  enrollments   Enrollment[]
  feeStructure  FeeStructure?

  timetableSessions TimetableSession[]

  @@unique([academicYearId, name])
  @@index([schoolId])
  @@index([roomId])
}

// Catalogue des salles de l'école (configuration/salles). Référencé par
// Class.roomId et TimetableSession.roomId ; le libellé reste copié dans leur
// champ `room` (texte) pour l'affichage et les lieux hors catalogue.
model Room {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("CLASSROOM") // CLASSROOM | LAB | COMPUTER | SPORTS | ARTS | OTHER
  capacity  Int?
  building  String?
  floor     String?
  equipment String? // texte libre ("Vidéoprojecteur, tableau blanc")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes  Class[]
  sessions TimetableSession[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSubject {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  coefficient Int?
  weeklyHours Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evaluations Evaluation[]

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([teacherId])
}

// ───────────────────────────────────────────────────────────────────────
// Epic 5 — people. Student/Guardian/Enrollment. Enrollment is year-scoped
// (not a direct Student.classId) so promotion doesn't corrupt prior years'
// historical bulletins — the reasoning OVERVIEW.md flagged up front as the
// single highest-leverage schema decision before any Epic 4/5 work started.
// See .planning/banani/epic-5-data-model.md.
// ───────────────────────────────────────────────────────────────────────
model Student {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentNumber  String // "EL-2024-001" — generated at creation, sequential per school
  firstName      String
  lastName       String
  photoUrl       String? // Cloudinary secure_url — public, see /api/upload docs
  dateOfBirth    DateTime
  placeOfBirth   String?
  gender         String? // free text, no fixed catalog yet
  nationality    String?
  address        String?
  enrolledAt     DateTime @default(now())
  status         String   @default("ENROLLED") // ENROLLED | REPEATED_ABSENCES | SUSPENDED
  // Profile fields from the Banani Add Student form (add-student.md).
  motherTongue   String?
  phone          String? // the student's own phone — guardians have theirs
  email          String?
  enrollmentType String? // Nouvelle inscription | Réinscription | Transfert — free text
  previousSchool String?
  transferNumber String?
  notes          String? // internal observations, staff-only
  scholarship    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guardians       Guardian[]
  enrollments     Enrollment[]
  grades          Grade[]
  goals           Goal[]
  appreciations   Appreciation[]
  attendance      Attendance[]
  feePayments     FeePayment[]
  feeDisputes     FeeDispute[]
  feeReminderLogs FeeReminderLog[]

  @@index([schoolId])
}

model Guardian {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  relationship String // "Père" | "Mère" | "Tuteur" — free text
  phone        String?
  email        String?
  profession   String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([studentId])
}

model Enrollment {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrolledAt     DateTime     @default(now())

  @@unique([studentId, academicYearId])
  @@index([classId])
}

// ───────────────────────────────────────────────────────────────────────
// Epic 6 — grades / évaluations. Evaluation hangs off ClassSubject (the
// Epic 4 shared pivot) + Term. Grade is per-student per-evaluation, nullable
// score (absence / not-yet-graded is a real state). Goal is the optional
// per-subject (or overall, subjectId null) target score a student/parent
// can set — see .planning/banani/epic-6-data-model.md for the weighting,
// trend, ranking and appreciation-bucket formulas the read side applies.
// ───────────────────────────────────────────────────────────────────────
model Evaluation {
  id                  String       @id @default(cuid())
  classSubjectId      String
  classSubject        ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  termId              String
  term                Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  label               String // "DS 1", "Interro" — teacher-authored free text
  type                String       @default("AUTRE") // DS | INTERROGATION | EXAMEN | AUTRE — display only
  maxScore            Int          @default(20)
  // Weight of this evaluation within its subject's average — distinct from
  // ClassSubject.coefficient (the subject's weight in the *overall* average).
  // "Devoir 1" and "Composition 1" in the same subject/term can carry
  // different weights against each other.
  coefficient         Int          @default(1)
  // "Prise en compte dans la moyenne" — a formative/practice evaluation can
  // be recorded without moving any average.
  countsTowardAverage Boolean      @default(true)
  // DRAFT | PUBLISHED. Only PUBLISHED evaluations count toward averages —
  // "Enregistrer brouillon" vs "Valider les notes" on Grade Entry.
  status              String       @default("DRAFT")
  // Internal remark, admin/teacher-only — distinct from Grade.comment
  // (which is per-student).
  notes               String?
  order               Int          @default(0)
  date                DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  grades Grade[]

  @@index([classSubjectId, termId, order])
}

model Grade {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float? // null = not yet graded
  // Explicit state — distinct from score:null. An absent student and a
  // not-yet-graded student are different things (Grade Notebook counts
  // them separately).
  absent       Boolean    @default(false)
  comment      String? // per-student per-evaluation teacher remark
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([evaluationId, studentId])
  @@index([studentId])
}

model Goal {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId      String
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjectId   String? // null = "Moyenne générale" (overall) goal
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  targetScore Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, termId, subjectId])
  @@index([studentId, termId])
}

// Two-level appreciation per (student, term): one "générale" row
// (subjectId null — mention, free-text comment, comportement/
// investissement/assiduité) and one row per subject the student is
// graded in. Same nullable-subjectId scoping as Goal, reused rather than
// inventing a second convention. `mention` is teacher-set, not purely
// derived from appreciationFor(average) — see .planning/banani/
// appreciations.md for why the two can legitimately disagree.
model Appreciation {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId         String
  term           Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjectId      String? // null = générale
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  mention        String? // TRES_BIEN | BIEN | ASSEZ_BIEN | PASSABLE | INSUFFISANT | FAIBLE
  text           String? // free-text remark
  comportement   String? // générale only
  investissement String? // générale only
  assiduite      String? // générale only
  // DRAFT | PUBLISHED — mirrors Evaluation.status; only PUBLISHED counts as
  // "Saisie" on the list screen (a draft doesn't appear on the bulletin).
  status         String   @default("DRAFT")
  authorId       String?
  author         User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, termId, subjectId])
  @@index([studentId, termId])
}

// ───────────────────────────────────────────────────────────────────────
// Epic 8 — attendance. Daily granularity (one row per student per calendar
// day, no subject dimension) — matches Attendance Tracking's weekly grid,
// which has day columns, not subject columns. No `classId`/`schoolId`
// stored directly: reached transitively via `studentId → Student.schoolId`
// and the student's `Enrollment` for whichever class is being viewed, same
// convention as `Goal`/`Appreciation` (neither stores `classId` either).
// No `termId` either — the read side derives a date range from the
// resolved `Term` via `resolveCurrentTerm()` instead of a stored FK.
// "Not recorded" (—) is simply the absence of a row for that student+date,
// mirroring `Grade.score: null`. See .planning/banani/attendance-tracking.md.
// ───────────────────────────────────────────────────────────────────────
model Attendance {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date          DateTime // calendar day, UTC-midnight normalized — no time component
  status        String // PRESENT | ABSENT | LATE | EXCUSED
  justification String? // free text, set via the edit/justify modal
  markedById    String?
  markedBy      User?    @relation(fields: [markedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, date])
  @@index([studentId, date])
}

// Fork-on-write template library: `schoolId: null` rows are the global/
// system gallery (seeded, shared read-only across every school); a school
// "personalizes" one by forking it (new row, schoolId set, forkedFromId
// traces lineage) rather than mutating the shared original in place. Forks
// never re-sync with their source — permanently independent once created.
// `isActive` is the school's currently-used template for generation; "at
// most one active per school" is an app-level invariant enforced in the
// route (same pattern as AcademicYear.isActive), not the schema.
model BulletinTemplate {
  id           String             @id @default(cuid())
  schoolId     String?
  school       School?            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isActive     Boolean            @default(false)
  forkedFromId String?
  forkedFrom   BulletinTemplate?  @relation("TemplateFork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        BulletinTemplate[] @relation("TemplateFork")
  config       Json
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([schoolId])
}

// ───────────────────────────────────────────────────────────────────────
// Frais & Scolarité — tuition fee tracking. FeeStructure is per-Class (Class
// is already year-scoped via @@unique([academicYearId, name]), so no
// separate academicYearId is needed here). FeePayment is a ledger, not a
// single row per tranche — a tranche can be paid across several partial
// entries, which is how a fractional "tranches paid" count (e.g. 1.5/3) is
// possible. Per-tranche/per-student payment status is always computed live
// from the ledger (same precedent as Term.status), never stored.
// See .planning/banani/frais-scolarite.md.
// ───────────────────────────────────────────────────────────────────────
model FeeStructure {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId         String   @unique
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  totalAmount     Int // annual total, HTG — integer, no decimals (same convention as FCFA elsewhere)
  registrationFee Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tranches FeeTranche[]

  @@index([schoolId])
}

model FeeTranche {
  id                   String       @id @default(cuid())
  feeStructureId       String
  feeStructure         FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  order                Int // 1, 2, 3…
  label                String // "1ère Tranche - Octobre"
  amount               Int // HTG
  dueDate              DateTime
  latePenaltyPercent   Int? // e.g. 5 — null = no penalty configured
  latePenaltyGraceDays Int? // grace period (days after dueDate) before the penalty applies
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  payments     FeePayment[]
  disputes     FeeDispute[]
  reminderLogs FeeReminderLog[]

  @@unique([feeStructureId, order])
}

enum FeePaymentMethod {
  ESPECES
  MONCASH
  NATCASH
  CHEQUE
  VIREMENT
}

model FeePayment {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTrancheId  String
  feeTranche    FeeTranche       @relation(fields: [feeTrancheId], references: [id], onDelete: Cascade)
  amount        Int // principal, HTG
  penaltyAmount Int              @default(0)
  method        FeePaymentMethod
  reference     String?
  notes         String?
  paidAt        DateTime         @default(now())
  recordedById  String
  recordedBy    User             @relation(fields: [recordedById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([studentId, feeTrancheId])
  @@index([schoolId])
}

// "Marquer comme litigieux" — a real open/resolve workflow item, not a bare
// boolean, since a dispute stays live until someone resolves it.
model FeeDispute {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTrancheId String
  feeTranche   FeeTranche @relation(fields: [feeTrancheId], references: [id], onDelete: Cascade)
  reason       String?
  openedById   String
  openedBy     User       @relation(fields: [openedById], references: [id])
  openedAt     DateTime   @default(now())
  resolvedAt   DateTime?

  @@index([studentId, feeTrancheId])
}

// One row per school. `autoRemindersEnabled` is the master switch (Payment
// Configuration's "Rappels automatiques" toggle); the 4 reminder* booleans
// are the granular rules (Relances' "Automatisation" card) that only fire
// once the master switch is on.
model FeeAutomationSettings {
  id                      String  @id @default(cuid())
  schoolId                String  @unique
  school                  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lateFeeEnabled          Boolean @default(true)
  autoRemindersEnabled    Boolean @default(false)
  reminderBefore5Days     Boolean @default(true)
  reminderOnDueDate       Boolean @default(true)
  reminderWeeklyOverdue   Boolean @default(false)
  reminderCriticalOverdue Boolean @default(true)
  currency                String  @default("HTG")
}

enum FeeReminderRule {
  BEFORE_5_DAYS
  DUE_DATE
  WEEKLY_OVERDUE
  CRITICAL_OVERDUE
}

// Cron dedup + source of the "Dernier rappel" column. `channel` is always
// "stub" for now — no SMS/WhatsApp/email provider is wired for this feature
// yet, so nothing is actually delivered; this only records that the system
// *would* have reminded this student, for real dedup and a real column
// value instead of an empty one. Kept as a real column so wiring an actual
// provider later is additive, not a schema change.
model FeeReminderLog {
  id           String          @id @default(cuid())
  studentId    String
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTrancheId String
  feeTranche   FeeTranche      @relation(fields: [feeTrancheId], references: [id], onDelete: Cascade)
  rule         FeeReminderRule
  channel      String          @default("stub")
  sentAt       DateTime        @default(now())

  @@index([studentId, feeTrancheId, rule])
}

// ───────────────────────────────────────────────────────────────────────
// EkolPlus SaaS billing — Epic 2 (.planning/banani/epic-2-admin-foundation.md).
// V1 is managed manually by the platform SUPERADMIN; Stripe will attach to
// these same models later (OVERVIEW decision: Stripe-only for SaaS billing).
// All amounts are integer USD cents — never decimals.
// ───────────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_MONTH
}

enum BillingMethod {
  STRIPE
  MANUAL
  BANK_TRANSFER
}

enum BillingStatus {
  SUCCEEDED
  PENDING
  FAILED
  REFUNDED
}

// Seeded catalog (STARTER / ESSENTIEL / PREMIUM). A school's monthly amount
// is computed live: active enrollments × pricePerStudentCents − coupon.
model SubscriptionPlan {
  id                   String   @id @default(cuid())
  key                  String   @unique // STARTER | ESSENTIEL | PREMIUM
  name                 String
  pricePerStudentCents Int
  currency             String   @default("USD")
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]
  coupons       Coupon[]
}

model Subscription {
  id          String             @id @default(cuid())
  schoolId    String             @unique
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId      String
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status      SubscriptionStatus @default(TRIAL)
  startedAt   DateTime           @default(now())
  renewsAt    DateTime
  trialEndsAt DateTime?
  couponId    String?
  coupon      Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  transactions  BillingTransaction[]
  statusChanges SubscriptionStatusChange[]

  @@index([status])
  @@index([renewsAt])
}

// Status-transition log — powers the churn/retention KPIs (Epic 2 decision
// Q2: real event tracking). Written in the same tx as every status change.
model SubscriptionStatusChange {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  createdAt      DateTime            @default(now())

  @@index([createdAt])
  @@index([subscriptionId, createdAt])
}

model Coupon {
  id             String            @id @default(cuid())
  code           String            @unique
  type           CouponType
  // PERCENT: percentage points (1-100). FIXED: USD cents. FREE_MONTH: free months.
  value          Int
  durationMonths Int? // null = permanent
  planId         String? // null = applies to all plans
  plan           SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  maxUses        Int? // null = unlimited
  usedCount      Int               @default(0)
  expiresAt      DateTime?
  schoolId       String? // optional restriction to one school
  school         School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  description    String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  subscriptions Subscription[]

  @@index([expiresAt])
}

model BillingTransaction {
  id             String              @id @default(cuid())
  reference      String              @unique // TXN-YYYYMMDD-NNNN
  schoolId       String
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountCents    Int // negative = refund
  method         BillingMethod
  status         BillingStatus
  paidAt         DateTime            @default(now())
  periodStart    DateTime // first day of the covered month
  // A REFUNDED row points at the transaction it reverses (1:1).
  refundOfId     String?             @unique
  refundOf       BillingTransaction? @relation("Refund", fields: [refundOfId], references: [id], onDelete: SetNull)
  refund         BillingTransaction? @relation("Refund")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([schoolId, paidAt])
  @@index([status, paidAt])
  @@index([paidAt])
}

// Login analytics — powers the admin activity heatmap and retention KPIs
// (Epic 2 decision Q2). Written by POST /api/auth/login only in V1 (the
// OAuth callback is a protected file — Google sign-ins don't log here yet).
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Platform-wide settings singleton (id = "singleton") — System Settings
// screen. Currency stays USD in V1 (screen shows it read-only).
model PlatformSettings {
  id                    String   @id @default("singleton")
  platformName          String   @default("Schoolgesti")
  domain                String?
  supportEmail          String?
  timezone              String   @default("America/Port-au-Prince")
  locale                String   @default("fr")
  logoUrl               String?
  trialDays             Int      @default(14)
  notifyNewSubscription Boolean  @default(true)
  notifyFailedPayment   Boolean  @default(true)
  weeklyReport          Boolean  @default(false)
  expiryReminders       Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Emploi du temps (emploi-du-temps.md). One row per concrete session; a
// weekly recurrence is expanded at creation into N rows sharing `seriesId`
// (delete « this session » or « the whole series »). `date` is a calendar
// day (UTC midnight), times are minutes from midnight (450 = 07:30) so no
// timezone drift. `color` overrides the subject's identity colour.
// ───────────────────────────────────────────────────────────────────────
model TimetableSession {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room           String? // libellé affiché (nom de la salle du catalogue ou lieu libre)
  roomId         String?
  roomRef        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  type           String       @default("CM") // CM | TD | TP | EXAM
  color          String?
  date           DateTime     @db.Date
  startMinutes   Int
  endMinutes     Int
  description    String?
  meetingUrl     String?
  seriesId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([schoolId, classId, date])
  @@index([schoolId, teacherId, date])
  @@index([schoolId, roomId, date])
  @@index([seriesId])
}
